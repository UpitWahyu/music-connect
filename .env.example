# --- Server ---
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
DATABASE_URL=mysql://root:root@localhost:3306/music_connect
PAIRING_CODE_TTL=300
DEVICE_TOKEN_TTL_DAYS=365
AUTO_QUEUE_THRESHOLD=2
AUTO_QUEUE_BATCH=10

# --- MikroTik (WOL remote wake-up, Phase 9) ---
MIKROTIK_HOST=router.example.com
MIKROTIK_PORT=8728
MIKROTIK_USER=hermes
MIKROTIK_PASSWORD=
MIKROTIK_WOL_INTERFACE=Bridge-Hotspot

# --- Player ---
MUSIC_SERVER_URL=ws://localhost:3000
DEVICE_ID=desktop
DEVICE_NAME=Desktop
DEVICE_TYPE=desktop
# PAIRING_CODE=123-456   (only needed on first run)
# MPV_SOCKET=/tmp/music-mpv.sock   (default: unix socket on Linux, named pipe on Windows)
HEARTBEAT_MS=5000
STATE_REPORT_MS=2000
