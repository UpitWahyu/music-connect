{
  "name": "music-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Spotify Connect-like self-hosted music system (PRD v1.1)",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @music-connect/server dev",
    "dev:player": "pnpm --filter @music-connect/player dev",
    "dev:web": "pnpm --filter @music-connect/web dev",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
